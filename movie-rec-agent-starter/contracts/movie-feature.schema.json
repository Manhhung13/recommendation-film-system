{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed MovieLens++ feature record",
  "type": "object",
  "required": [
    "movie_id",
    "title",
    "genres",
    "source_provenance"
  ],
  "properties": {
    "movie_id": {
      "type": "integer",
      "minimum": 0
    },
    "tmdb_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "imdb_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tag_genome": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "overview": {
      "type": [
        "string",
        "null"
      ]
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "director": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime": {
      "type": [
        "integer",
        "null"
      ]
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "source_provenance": {
      "type": "object"
    }
  }
}
