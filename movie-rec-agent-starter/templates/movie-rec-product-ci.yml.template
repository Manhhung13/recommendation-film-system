# Copy to .github/workflows/movie-rec-product-ci.yml only after backend, tests and deps exist.
name: movie-rec-product
on:
  push:
    branches: [main, 'feature/**']
  pull_request:
    branches: [main]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Install application dependencies
        run: pip install -e '.[dev]'
      - name: Lint
        run: ruff check .
      - name: Product tests
        run: pytest -q tests/data tests/recommender tests/api tests/e2e
